# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
SERPAPI_API_KEY=
TAVILY_API_KEY=

# Microsoft Foundry / Azure OpenAI (used by "azure/<deployment>" models in config/models.yaml)
AZURE_API_KEY=
AZURE_API_BASE=
AZURE_API_VERSION=

# LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=contentblitz

# Where images and Brand Profiles are stored (mounted volume in Docker/Azure)
CONTENTBLITZ_DATA_DIR=data
