  "cards": [
    { "dot": "cyan", "title": "One message, end to end", "items": [
      "Query Handler asks the model for a routing decision: chat, unclear, new_content or refine",
      "New content becomes a plan; research + strategist go first when no Research Brief exists (ADR 0001)",
      "Dispatcher sends each plan step to its agent; the agent reports back and the dispatcher picks the next step until the plan is done"
    ] },
    { "dot": "amber", "title": "Built vs. stub", "items": [
      "Built: UI, Query Handler, routing, planning, Topics, refine targeting, LiteLLM gateway",
      "Stubs: the five specialist agents only post a progress message for now",
      "search.py exists but no agent calls it yet; writers will call llm.py too"
    ] },
    { "dot": "emerald", "title": "Ops", "items": [
      "GitHub Actions: CI (lint, tests, Docker build), then deploy to Azure Container Apps on main",
      "State lives in memory, so the app runs as one replica",
      "LangSmith tracing is opt-in through LiteLLM callbacks"
    ] }
  ]
